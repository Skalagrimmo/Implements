{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelgen.local/schemas/contract-manifest-0.9.2.schema.json",
  "title": "PixelGen Contract Manifest 0.9.2",
  "type": "object",
  "required": ["manifest_version", "contract_status", "contract_fingerprint", "artifact_count", "artifacts", "relationships"],
  "properties": {
    "manifest_version": {"const": "0.9.2"},
    "contract_status": {"const": "freeze_candidate"},
    "contract_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifacts": {"type": "array"},
    "relationships": {"type": "object"}
  },
  "additionalProperties": true
}
