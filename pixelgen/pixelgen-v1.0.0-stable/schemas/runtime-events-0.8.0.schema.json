{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelgen.local/schemas/runtime-events-0.8.0.schema.json",
  "title": "PixelGen Runtime Event Log 0.8.0",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "event_type", "target_type", "target_id", "amount", "source"],
    "properties": {
      "id": {"type": "string"},
      "event_type": {"type": "string"},
      "target_type": {"enum": ["front", "territory"]},
      "target_id": {"type": "string"},
      "amount": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
      "source": {"type": "string"}
    },
    "additionalProperties": true
  }
}
